# Proveedor y modelo de lenguaje (la clave SOLO vive aquí o en las variables del servidor; nunca en el repositorio)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Controles de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
MAX_TOKENS_RESPUESTA=4096
LLM_TIMEOUT_MS=60000

# Puerto HTTP (Render lo define solo)
PORT=3000
